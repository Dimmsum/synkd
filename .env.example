# whosfree environment variables (WF-007).
#
# This file is a template and is committed. Real values go in local files that git ignores
# (`.env*` is ignored, except this file). Never paste secret keys into issues, PRs or chat:
# the repo is public.
#
# Where each group goes:
#   - Web app (Next.js):    apps/web/.env.local   (and Vercel project settings for deploys)
#   - Supabase CLI:         your shell, or packages/backend/.env (used for link / db push)
#   - Parser / eval harness packages/parser/.env.local (once the package exists)
#   - Worker:               apps/worker/.env.local (once it exists) and Railway settings
#
# NEXT_PUBLIC_* values are sent to the browser, so only publishable values may use that prefix.
# Marked [NOW] = needed for Milestone A work that is ready; [LATER] = fill in when the issue starts.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# [NOW] Base URL of the web app (used for OAuth callbacks, invite links, emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (WF-003, D40) — Dashboard > Project Settings > API / API Keys
# ---------------------------------------------------------------------------
# [NOW] Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# [NOW] Publishable key (sb_publishable_…; the legacy "anon" key also works). Safe in the browser:
# row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [NOW] Secret key (sb_secret_…; the legacy "service_role" key also works). SERVER ONLY: it
# bypasses row-level security. Used only for background work (webhooks, cron routes, worker
# callbacks), never for requests made on a user's behalf (D41).
SUPABASE_SECRET_KEY=

# [NOW] For the Supabase CLI to link the project and push migrations (`supabase link`, `db push`).
# Project ref = the subdomain of the project URL. Access token: Account > Access Tokens.
# Database password: the one set when the project was created (Project Settings > Database).
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Clerk (WF-004, D19) — Dashboard > Configure > API Keys
# ---------------------------------------------------------------------------
# Setup notes:
#   - Enable Google as the only sign-in method (basic scopes only; no calendar scopes).
#   - Connect Clerk to Supabase (Clerk: Integrations > Supabase; Supabase: Authentication >
#     Third-Party Auth > Clerk). Session tokens must include the claim role = "authenticated",
#     or every database call is denied.
# [NOW] Publishable key (pk_test_… / pk_live_…). Safe in the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# [NOW] Secret key (sk_test_… / sk_live_…). SERVER ONLY.
CLERK_SECRET_KEY=
# [NOW] Clerk Frontend API domain, e.g. your-app-12.clerk.accounts.dev (used by Supabase
# third-party auth in packages/backend/supabase/config.toml).
CLERK_DOMAIN=
# Our own sign-in / sign-up pages (custom UI, not Clerk's hosted pages).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# [LATER] Only if we add a Clerk webhook (see the note in the ensure_current_user migration).
CLERK_WEBHOOK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# OpenRouter (WF-013, D15, NFR-SEC-8)
# ---------------------------------------------------------------------------
# [NOW] API key. Only ever in the parser/eval harness and the worker environment. NEVER in
# apps/web and never with a NEXT_PUBLIC_ prefix. Set a spend limit on the account, and exclude
# providers that store or train on prompts.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Worker (WF-025, NFR-SEC-5) — only if the WF-024 spike keeps the worker
# ---------------------------------------------------------------------------
# [LATER] Where the Next.js server reaches the worker, and the shared HMAC secret both sides use
# to sign requests. Generate with: openssl rand -base64 32
WORKER_URL=
WORKER_HMAC_SECRET=

# ---------------------------------------------------------------------------
# Scheduled jobs (WF-037, WF-082)
# ---------------------------------------------------------------------------
# [LATER] Shared secret that Supabase Cron sends to the protected server routes it calls.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Web Push (WF-091)
# ---------------------------------------------------------------------------
# [LATER] Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact URL, e.g. mailto:support@example.com
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# Google Calendar (WF-080, D30, NFR-SEC-3) — Milestone B
# ---------------------------------------------------------------------------
# [LATER] OAuth client for our own calendar.readonly flow (separate from Clerk's sign-in).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# [LATER] 32-byte key for encrypting refresh tokens (AES-256-GCM). SERVER ONLY.
# Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Observability (WF-008, NFR-SEC-12) — Milestone B
# ---------------------------------------------------------------------------
# [LATER] Sentry (sendDefaultPii: false; turn off IP storage in project settings).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# [LATER] PostHog (IP capture off; no titles, ping text or schedule contents).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# "Now" for the web app's mock data. Empty = a fixed moment that matches the design; an ISO
# date-time pins another moment; `real` uses the actual clock. Removed with the mock layer (WF-064).
WHOSFREE_MOCK_NOW=
